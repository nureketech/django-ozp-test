# Gunicorn — Django сайтын іске қосатын systemd сервисі.
# Орнату: sudo cp deploy/gunicorn.service /etc/systemd/system/ozp-test.service
#         sudo systemctl daemon-reload && sudo systemctl enable --now ozp-test
# Журнал:  sudo journalctl -u ozp-test -f

[Unit]
Description=OZP test platform (Gunicorn)
After=network.target postgresql.service

[Service]
User=ozp
Group=ozp
WorkingDirectory=/srv/ozp-test
# Баптаулар .env файлынан оқылады (config/settings.py)
# 3 жұмысшы процесс — 2 ядро / 2 ГБ RAM серверге (өлшеу бойынша ~300–500 студент
# бір мезгілде, DEPLOY.md «Сыйымдылық және тест күні»). 4 ядро болса — 5–9.
ExecStart=/srv/ozp-test/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind 127.0.0.1:8001 \
    --timeout 60 \
    --access-logfile -
# Қате болып тоқтаса — қайта іске қосылады
Restart=always
RestartSec=3

[Install]
# Сервер қайта жүктелгенде сайт өзі іске қосылады
WantedBy=multi-user.target
